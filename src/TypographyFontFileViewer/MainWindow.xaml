<Window x:Class="TypographyFontFileViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typography Font File Viewer 1.0"
        Height="560" Width="900"
        MinHeight="360" MinWidth="560"
        Background="White"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="Phase 1 — font engine core"
                           FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="Starting the engine…" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedText}"
                       TextTrimming="CharacterEllipsis"
                       Text="Starting…" />
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16"
                      SizeChanged="OnViewportSizeChanged">
            <StackPanel>
                <!-- Shaped by HarfBuzz, rasterized by FreeType, wrapped to this panel,
                     handed to WPF as a frozen bitmap of plain bytes. -->
                <Image x:Name="PreviewImage"
                       HorizontalAlignment="Left"
                       Stretch="None"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />

                <TextBlock x:Name="DetailsText"
                           Margin="0,16,0,0"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas, Courier New"
                           LineHeight="18" />

                <TextBlock x:Name="ErrorText"
                           Visibility="Collapsed"
                           Foreground="#FFB3261E"
                           TextWrapping="Wrap"
                           FontFamily="Consolas, Courier New"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
