<Window x:Class="TypographyFontFileViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typography Font File Viewer 1.0"
        Height="460" Width="860"
        MinHeight="320" MinWidth="520"
        Background="White"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="Phase 0 — scaffold and de-risk"
                           FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Text="Rendering through FreeType and HarfBuzz…" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedText}"
                       TextTrimming="CharacterEllipsis"
                       Text="Starting…" />
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16">
            <StackPanel>
                <!-- The whole point of the phase: these pixels come from FreeType,
                     positioned by HarfBuzz, with nothing installed on the machine. -->
                <Image x:Name="SpikeImage"
                       HorizontalAlignment="Left"
                       Stretch="None"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />

                <TextBlock x:Name="ErrorText"
                           Visibility="Collapsed"
                           Foreground="#FFB3261E"
                           TextWrapping="Wrap"
                           FontFamily="Consolas, Courier New"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
