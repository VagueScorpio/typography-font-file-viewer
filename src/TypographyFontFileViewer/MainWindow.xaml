<Window x:Class="TypographyFontFileViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TypographyFontFileViewer.Views"
        xmlns:vm="clr-namespace:TypographyFontFileViewer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Typography Font File Viewer"
        Height="680" Width="1080"
        MinHeight="420" MinWidth="720"
        Background="White"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.CommandBindings>
        <CommandBinding Command="Find" Executed="OnFocusSearch" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="Find" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenFolderCommand}" />
        <!-- Next and previous work from anywhere, including inside the text box. -->
        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding NextFontCommand}" />
        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding PreviousFontCommand}" />
        <KeyBinding Key="Home" Modifiers="Control" Command="{Binding FirstFontCommand}" />
        <KeyBinding Key="End" Modifiers="Control" Command="{Binding LastFontCommand}" />
        <KeyBinding Key="F5" Command="{Binding RescanCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding ToggleFavoriteCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding OpenFavoritesCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding ToggleSubfoldersCommand}" />
        <!-- The numbers run 1 to 4 across the whole window, as they did when these were
             four flat tabs: 1, 3 and 4 are panels of the single-font view, 2 is the
             gallery. Ctrl+3 and Ctrl+4 fall back to Preview until Phase 6 builds them. -->
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowPanelCommand}" CommandParameter="Preview" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="Gallery" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowPanelCommand}" CommandParameter="Glyphs" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShowPanelCommand}" CommandParameter="Info" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding ToggleViewCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Font…" InputGestureText="Ctrl+O"
                          Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open _Folder…" InputGestureText="Ctrl+Shift+O"
                          Command="{Binding OpenFolderCommand}" />

                <MenuItem Header="Recent folders"
                          ItemsSource="{Binding RecentFolders}"
                          IsEnabled="{Binding RecentFolders.Count}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenRecentCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="Show _Favorites folder" InputGestureText="Ctrl+Shift+F"
                          Command="{Binding OpenFavoritesCommand}" />
                <MenuItem Header="Open Favorites folder in _Explorer"
                          Command="{Binding OpenFavoritesInExplorerCommand}" />
                <Separator />
                <MenuItem Header="_Rescan folder" InputGestureText="F5"
                          Command="{Binding RescanCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Single font" InputGestureText="Ctrl+1"
                          IsCheckable="True"
                          IsChecked="{Binding IsSingleFont, Mode=OneWay}"
                          Command="{Binding ShowPanelCommand}" CommandParameter="Preview" />
                <MenuItem Header="_Gallery" InputGestureText="Ctrl+2"
                          IsCheckable="True"
                          IsChecked="{Binding IsGallery, Mode=OneWay}"
                          Command="{Binding ShowViewCommand}" CommandParameter="Gallery" />
                <Separator />
                <MenuItem Header="_Next font" InputGestureText="Ctrl+Down"
                          Command="{Binding NextFontCommand}" />
                <MenuItem Header="_Previous font" InputGestureText="Ctrl+Up"
                          Command="{Binding PreviousFontCommand}" />
                <Separator />
                <MenuItem Header="_Bigger" InputGestureText="Ctrl+=" Click="OnBiggerClick" />
                <MenuItem Header="_Smaller" InputGestureText="Ctrl+-" Click="OnSmallerClick" />
                <Separator />
                <MenuItem Header="Sort by">
                    <MenuItem Header="File name" IsCheckable="True"
                              IsChecked="{Binding IsSortedByFileName, Mode=OneWay}"
                              Command="{Binding SetSortCommand}" CommandParameter="FileName" />
                    <MenuItem Header="Family name" IsCheckable="True"
                              IsChecked="{Binding IsSortedByFamily, Mode=OneWay}"
                              Command="{Binding SetSortCommand}" CommandParameter="FamilyName" />
                    <MenuItem Header="Format" IsCheckable="True"
                              IsChecked="{Binding IsSortedByFormat, Mode=OneWay}"
                              Command="{Binding SetSortCommand}" CommandParameter="Format" />
                </MenuItem>
                <MenuItem Header="Include _subfolders" InputGestureText="Ctrl+Shift+S"
                          IsCheckable="True"
                          IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="_Dark preview background"
                          IsCheckable="True"
                          IsChecked="{Binding Preview.DarkBackground, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About…" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Open…" Command="{Binding OpenFileCommand}" Padding="8,2" />
                <Button Content="Open Folder…" Command="{Binding OpenFolderCommand}" Padding="8,2" />
                <Separator />
                <Button Content="Rescan" Command="{Binding RescanCommand}" Padding="8,2" />
                <Separator />
                <Button Command="{Binding OpenFavoritesCommand}"
                        Padding="8,2"
                        ToolTip="Show the Favorite Fonts folder beside the app. Ctrl+Shift+F">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2605;" Foreground="#FFE0A516" Margin="0,0,5,0" />
                        <TextBlock Text="Favorites" />
                    </StackPanel>
                </Button>
                <Separator />

                <!-- Search filters both the list and the gallery, as you type. -->
                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="4,0,4,0"
                           Foreground="{StaticResource MutedText}" />
                <TextBox x:Name="SearchBox"
                         Width="190"
                         VerticalAlignment="Center"
                         KeyDown="OnSearchKeyDown"
                         ToolTip="Filter by file name, family or style. Ctrl+F to focus, Esc to clear."
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                <Button Content="&#x2715;"
                        Padding="6,1"
                        Margin="2,0,0,0"
                        ToolTip="Clear the search"
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding IsFiltered, Converter={StaticResource BooleanToVisibility}}" />

                <CheckBox Content="Subfolders"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip="Include fonts in subfolders. Ctrl+Shift+S"
                          IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}" />
            </ToolBar>
        </ToolBarTray>

        <!-- Anything the app needs to tell the user that is not an error in a font:
             a path that does not exist, a folder with nothing in it. -->
        <Border DockPanel.Dock="Top"
                Background="#FFFDF4DA"
                BorderBrush="#FFE4CE8D"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Foreground="#FF6B5A14" />
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="VersionLabel"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedText}" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <views:FontListView Grid.Column="0" DataContext="{Binding}" />

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource PanelBorder}" />

            <DockPanel Grid.Column="2">

                <!-- The selected font's name, and the switch between the two views. -->
                <Border DockPanel.Dock="Top"
                        Padding="12,8"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    Visibility="{Binding IsSingleFont, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="{Binding SelectedFont.DisplayName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- The star for the font on screen. -->
                            <Button Command="{Binding ToggleFavoriteCommand}"
                                    Margin="10,0,0,0"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    ToolTip="Copy this font to the Favorite Fonts folder. Ctrl+D">
                                <TextBlock FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2606;" />
                                            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFont.IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="&#x2605;" />
                                                    <Setter Property="Foreground" Value="#FFE0A516" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="0"
                                   Text="All fonts in this folder"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsGallery, Converter={StaticResource BooleanToVisibility}}" />

                        <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}"
                                             GroupName="ViewMode"
                                             Content="Single font"
                                             ToolTip="One font, large. Ctrl+1"
                                             IsChecked="{Binding CurrentView, Mode=TwoWay,
                                                         Converter={StaticResource EnumToBoolean},
                                                         ConverterParameter=SingleFont}" />
                                <RadioButton Style="{StaticResource SegmentButton}"
                                             GroupName="ViewMode"
                                             Content="Gallery"
                                             ToolTip="Every font at once. Ctrl+2"
                                             IsChecked="{Binding CurrentView, Mode=TwoWay,
                                                         Converter={StaticResource EnumToBoolean},
                                                         ConverterParameter=Gallery}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Both views stay loaded so switching keeps each one's scroll position.
                     The hidden one unloads its rows, which cancels their renders. -->
                <Grid>
                    <views:SingleFontView
                        Visibility="{Binding CurrentView,
                                     Converter={StaticResource EnumToVisibility},
                                     ConverterParameter=SingleFont}" />

                    <views:GalleryView x:Name="Gallery"
                                       RowActivated="OnGalleryRowActivated"
                                       Visibility="{Binding CurrentView,
                                                    Converter={StaticResource EnumToVisibility},
                                                    ConverterParameter=Gallery}" />
                </Grid>
            </DockPanel>

            <!-- Shown before anything has been opened. -->
            <TextBlock Grid.Column="2"
                       Text="Open a font file or a folder to begin.&#x0a;You can also drag one onto this window."
                       Margin="24"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedText}"
                       IsHitTestVisible="False"
                       Visibility="{Binding VisibleFonts.Count, Converter={StaticResource EmptyToVisibility}}" />
        </Grid>

    </DockPanel>
</Window>
