<UserControl x:Class="TypographyFontFileViewer.Views.FontListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TypographyFontFileViewer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <DockPanel>

        <!-- Which folder, and how much is in it. -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <StackPanel>
                <TextBlock Text="{Binding CurrentFolder}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CurrentFolder}" />
                <TextBlock Text="{Binding FolderSummary}"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedText}" />
            </StackPanel>
        </Border>

        <ListBox x:Name="FontList"
                 ItemsSource="{Binding Fonts}"
                 SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                 SelectionChanged="OnSelectionChanged"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FontItemViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- A file that would not open is marked, never hidden. -->
                        <TextBlock Grid.Column="0"
                                   Text="&#xE7BA;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="#FFB3261E"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBroken, Converter={StaticResource BooleanToVisibility}}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding FaceLabel}"
                                   Margin="6,0,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="3"
                                Margin="8,0,0,0"
                                Padding="4,1"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="#FFE8E8E2">
                            <TextBlock Text="{Binding FormatBadge}"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedText}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
