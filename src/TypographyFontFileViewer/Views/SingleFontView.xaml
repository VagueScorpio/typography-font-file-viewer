<UserControl x:Class="TypographyFontFileViewer.Views.SingleFontView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TypographyFontFileViewer.Views"
             xmlns:vm="clr-namespace:TypographyFontFileViewer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">

    <!--
        One font, three ways of looking at it. Preview is here now; Glyphs and Info join
        it in Phase 6. All three belong inside this view rather than beside the gallery,
        because all three describe the one selected font.
    -->
    <TabControl x:Name="Panels"
                BorderThickness="0"
                Padding="0"
                SelectedIndex="{Binding CurrentPanel, Mode=TwoWay, Converter={StaticResource EnumToIndex}}">

        <TabItem Header="Preview">
            <views:PreviewView DataContext="{Binding Preview}" />
        </TabItem>

    </TabControl>
</UserControl>
