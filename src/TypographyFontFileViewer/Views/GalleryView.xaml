<UserControl x:Class="TypographyFontFileViewer.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TypographyFontFileViewer.Controls"
             xmlns:vm="clr-namespace:TypographyFontFileViewer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d"
             x:Name="Root">

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" />

                <!-- Named sizes, and the slider for anything in between. -->
                <Border Style="{StaticResource SegmentTrack}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="GallerySize"
                                     Content="S" Padding="11,3" ToolTip="Small — 16 pt"
                                     IsChecked="{Binding Gallery.GallerySize, Mode=TwoWay,
                                                 Converter={StaticResource DoubleEquals}, ConverterParameter=16}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="GallerySize"
                                     Content="M" Padding="11,3" ToolTip="Medium — 28 pt"
                                     IsChecked="{Binding Gallery.GallerySize, Mode=TwoWay,
                                                 Converter={StaticResource DoubleEquals}, ConverterParameter=28}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="GallerySize"
                                     Content="L" Padding="11,3" ToolTip="Large — 44 pt"
                                     IsChecked="{Binding Gallery.GallerySize, Mode=TwoWay,
                                                 Converter={StaticResource DoubleEquals}, ConverterParameter=44}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="GallerySize"
                                     Content="XL" Padding="9,3" ToolTip="Extra large — 72 pt"
                                     IsChecked="{Binding Gallery.GallerySize, Mode=TwoWay,
                                                 Converter={StaticResource DoubleEquals}, ConverterParameter=72}" />
                    </StackPanel>
                </Border>

                <Slider Width="150" Margin="12,0,0,0"
                        Minimum="8" Maximum="96"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center"
                        ToolTip="Any size between the presets"
                        Value="{Binding Gallery.GallerySize, Mode=TwoWay}" />

                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           MinWidth="66"
                           Text="{Binding Gallery.SizeName}"
                           Foreground="{StaticResource MutedText}" />

                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedText}"
                           Text="Double-click a font to open it large." />
            </StackPanel>
        </Border>

        <ListBox x:Name="GalleryList"
                 ItemsSource="{Binding Fonts}"
                 SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnRowDoubleClick"
                 PreviewMouseWheel="OnGalleryMouseWheel"
                 Background="{Binding Gallery.Background}"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.IsDeferredScrollingEnabled="False"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.CacheLength="1"
                 VirtualizingPanel.CacheLengthUnit="Page">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FontItemViewModel}">
                    <Grid Height="{Binding DataContext.Gallery.RowHeight, ElementName=Root}"
                          Margin="10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- The small label: which file this is. -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding File.FileName}"
                                       FontSize="10"
                                       Foreground="#FF9AA3AB" />
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       Foreground="#FF9AA3AB" />
                            <TextBlock Text="{Binding FaceLabel}"
                                       FontSize="10"
                                       Margin="6,0,0,0"
                                       Foreground="#FF9AA3AB" />
                        </StackPanel>

                        <!-- The font, drawn in itself. Clipped rather than wrapped. -->
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <controls:FontRenderImage
                                Face="{Binding Key}"
                                Gallery="{Binding DataContext.Gallery, ElementName=Root}"
                                Epoch="{Binding DataContext.Gallery.Epoch, ElementName=Root}"
                                Visibility="{Binding IsBroken, Converter={StaticResource InverseBooleanToVisibility}}" />

                            <!-- A font that will not open says why, where its preview would be. -->
                            <TextBlock Text="{Binding Error}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#FFB3261E"
                                       FontSize="12"
                                       Visibility="{Binding IsBroken, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
