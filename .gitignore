# ---- Build output ----
[Bb]in/
[Oo]bj/
publish/
*.zip

# ---- Visual Studio / Rider / VS Code ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# ---- NuGet ----
*.nupkg
*.snupkg
packages/
!packages/build/

# ---- Debug symbols (symbols are embedded; a .pdb must never ship) ----
*.pdb

# ---- Test fonts (licensed material, built locally; see docs blueprint 13.1) ----
tests/fonts/*
!tests/fonts/.gitkeep
!tests/fonts/README.md

# ---- Python tooling for the test fonts (the scripts are committed, the venv is not) ----
tools/.venv/
tools/__pycache__/
*.pyc

# ---- Runtime files the app creates next to the exe (portable app) ----
TypographyFontFileViewer.json
TypographyFontFileViewer.json.bad
TypographyFontFileViewer.json.tmp
TypographyFontFileViewer.log
Favorite Fonts/

# ---- OS cruft ----
Thumbs.db
desktop.ini
.DS_Store
